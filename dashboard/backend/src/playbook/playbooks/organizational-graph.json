{
  "id": "organizational-graph",
  "name": "Organizational graph",
  "description": "Employees, corporations, and employed_by links — a classic enterprise org ontology with graph ingest.",
  "instructions": "1. Install this playbook, then open the playbook view for record types, schema relationships, and the ingest workflow.\n2. POST JSON to the workflow webhook (array of objects or { \"records\": [...] }). Each row should include employee fields plus corporation_name for linking.\n3. Create corporation rows first, or include corporation_name on each employee payload.\n4. Sync RDF cache (Settings → Caching), open Graph View, and run SPARQL to traverse employees and employers.\n\nExample payload:\n{ \"records\": [{ \"full_name\": \"Jane Smith\", \"job_title\": \"Engineer\", \"email\": \"jane@acme.example\", \"corporation_name\": \"Acme Corp\" }] }\n\n**MCP (playbook id: `organizational-graph`):** health_check → anythinggraph://schema-summary or get_entity → create_entity_row / create_row_relationship. Bulk ingest via workflow webhook after install.",
  "entities": [
    {
      "name": "employee",
      "display_name": "Employee",
      "fields": [
        {
          "field_name": "full_name",
          "field_type": "TEXT",
          "is_required": true,
          "is_identifier": true,
          "description": "Employee full name",
          "example": "Jane Smith"
        },
        {
          "field_name": "job_title",
          "field_type": "TEXT",
          "description": "Role or title",
          "example": "Software Engineer"
        },
        {
          "field_name": "email",
          "field_type": "TEXT",
          "description": "Work email",
          "example": "jane@acme.example"
        },
        {
          "field_name": "corporation_name",
          "field_type": "TEXT",
          "description": "Employer name used to link to Corporation",
          "example": "Acme Corp"
        }
      ]
    },
    {
      "name": "corporation",
      "display_name": "Corporation",
      "fields": [
        {
          "field_name": "corporation_name",
          "field_type": "TEXT",
          "is_required": true,
          "is_identifier": true,
          "description": "Legal or trade name",
          "example": "Acme Corp"
        },
        {
          "field_name": "country",
          "field_type": "TEXT",
          "description": "Headquarters country",
          "example": "US"
        }
      ]
    }
  ],
  "entity_relationships": [
    {
      "ref": "employee_employed_by_corporation",
      "relationship_name": "employed_by",
      "subject_entity_name": "employee",
      "object_entity_name": "corporation"
    }
  ],
  "workflows": [
    {
      "name": "Organizational ingest",
      "description": "Create employees and link them to corporations by corporation_name.",
      "graph": {
        "nodes": [
          {
            "id": "trigger-1",
            "type": "trigger",
            "position": { "x": 80, "y": 200 },
            "data": { "label": "Trigger", "triggerType": "webhook" }
          },
          {
            "id": "entities-employee",
            "type": "entities",
            "position": { "x": 360, "y": 200 },
            "data": {
              "label": "Employees",
              "entityRef": "employee",
              "minMatchScore": 1
            }
          },
          {
            "id": "relationships-1",
            "type": "relationships",
            "position": { "x": 640, "y": 200 },
            "data": {
              "label": "Employed by",
              "entityRelationshipRef": "employee_employed_by_corporation",
              "payloadLinkField": "corporation_name",
              "objectEntityField": "corporation_name"
            }
          },
          {
            "id": "fallback-1",
            "type": "fallback",
            "position": { "x": 920, "y": 200 },
            "data": { "label": "Fallback", "action": "landing_zone" }
          }
        ],
        "edges": [
          {
            "id": "edge-trigger-employee",
            "type": "deletable",
            "source": "trigger-1",
            "target": "entities-employee",
            "sourceHandle": "success"
          },
          {
            "id": "edge-employee-rel",
            "type": "deletable",
            "source": "entities-employee",
            "target": "relationships-1",
            "sourceHandle": "success"
          },
          {
            "id": "edge-employee-fallback",
            "type": "deletable",
            "source": "entities-employee",
            "target": "fallback-1",
            "sourceHandle": "failure"
          },
          {
            "id": "edge-rel-fallback",
            "type": "deletable",
            "source": "relationships-1",
            "target": "fallback-1",
            "sourceHandle": "failure"
          }
        ]
      }
    }
  ]
}
