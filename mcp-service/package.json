{
  "name": "ontology-mcp-service",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "MCP server for AnythingGraph data-layer and RDF cache (stdio)",
  "bin": {
    "anythinggraph-mcp": "./dist/index.js"
  },
  "scripts": {
    "dev": "tsx src/index.ts",
    "build": "esbuild src/index.ts --bundle --platform=node --format=esm --outfile=dist/index.js --packages=external --banner:js=#!/usr/bin/env\\ node",
    "typecheck": "tsc --noEmit",
    "test:mcp": "node scripts/test-mcp.mjs",
    "start": "node dist/index.js"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/node": "^22.13.10",
    "esbuild": "^0.25.0",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2"
  }
}
